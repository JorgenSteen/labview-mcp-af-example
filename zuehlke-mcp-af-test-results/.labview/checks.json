      "kind": "vi",
      "project": "closed",
      "read_only": ["Pass", "error out"],
      "returns": true,
      "inputs": {},
      "expected": { "pass": "Pass", "error out code": 0 },
      "side_effects": "none",
      "evidence": "proof/runs/<X>-checks.txt"
    },
    {
