	<Property Name="NI.Lib.ContainingLib" Type="Str">ZM-CM-communication_manager.lvlib</Property>
	<Property Name="NI.Lib.ContainingLibPath" Type="Str">../../ZM-CM-communication_manager.lvlib</Property>
	<Property Name="NI.Lib.Description" Type="Str">Communication manager actor: owns a communication protocol from its pre-launch settings, initialises it in Pre Launch Init, publishes every package it receives, and closes it in Stop Core. Error-handling plan: none yet; an error stops the actor, and its Last Ack stops the root and the whole tree.</Property>
